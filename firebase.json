{
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": ["**/.*"],
    "rewrites": [{ "source": "/i/**", "destination": "/guest/index.html" }],
    "headers": [
      {
        "regex": "^/($|i/.*$|guest/(index\\.html|flutter_bootstrap\\.js|main\\.dart\\.js|flutter_service_worker\\.js)$|index\\.html$|flutter_bootstrap\\.js$|main\\.dart\\.js$|flutter_service_worker\\.js$)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
